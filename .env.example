# Copy this file to `.env` and fill in your own key.
# `.env` is git-ignored and is read automatically at startup (src/config.py).
# Never commit the real key.

# --- Groq (free tier, cloud, OpenAI-compatible) ---------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional overrides
# INDICVOICE_LLM_BACKEND=groq
# INDICVOICE_LLM_MODEL=llama-3.3-70b-versatile

# --- OpenAI-compatible alternative ---------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local Ollama (no key needed) ----------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434

# --- latency vs accuracy --------------------------------------------------
# fast (default): Tamil/Telugu/Kannada/English use cloud ASR (~0.5 s).
# accurate: every language uses the local model (slower, but never garbles).
# INDICVOICE_STT_MODE=accurate
# INDICVOICE_REASONING_EFFORT=low

# --- access control -------------------------------------------------------
# Any non-empty value makes /ws/voice and /ws/telephony require ?token=<value>.
# REQUIRED for any non-localhost bind: the server refuses to start without it
# (fail closed). Localhost development may run open.
# INDICVOICE_TOKEN=change-me-long-random-string

# Extra browser origins allowed on the WebSocket endpoints (comma-separated).
# Localhost origins are always allowed; non-browser clients send no Origin.
# INDICVOICE_ALLOWED_ORIGINS=https://calls.example.com
